{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "test14-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGIN": "https://xlox123456789.github.io" },
  "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "test14-feedback-private" }],
  "ratelimits": [{ "name": "REPORT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": false }
}
